{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "blank",
  "version": "0.1.0",
  "identifier": "app.blank.editor",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://127.0.0.1:5173", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
